# ==============================================================================
# chacha-bot 환경변수 예시 파일 (.env.example)
#
# 주의:
# 1. 이 파일은 템플릿입니다. 실제 비밀값(API Key 등)을 입력하지 마세요.
# 2. 로컬 실행 시 이 파일을 복사하여 '.env' 파일을 만든 후 실제 값을 입력하세요:
#    cp .env.example .env (또는 Windows: copy .env.example .env)
# 3. .env 파일은 .gitignore에 등록되어 저장소에 커밋되지 않습니다.
# ==============================================================================

# ------------------------------------------------------------------------------
# 1. Gemini LLM API 설정 (명세서 7장 필수 항목)
# ------------------------------------------------------------------------------
# Google AI Studio(https://aistudio.google.com/)에서 발급받은 API 키
# [중요] 절대 커밋하거나 외부에 노출하지 마세요!
GEMINI_API_KEY=

# 사용할 Gemini 모델명 (명세서 7장 필수값)
# Google AI Studio에서 무료로 쓸 수 있는 최신 모델을 입력하세요.
# 추천: gemini-3.5-flash-lite
GEMINI_MODEL=gemini-3.5-flash-lite

# ------------------------------------------------------------------------------
# 2. 대화 및 맥락(Context) 설정 (명세서 7장)
# ------------------------------------------------------------------------------
# LLM에 전달할 최근 대화 턴 수 (기본값: 10턴 = 메시지 최대 20개)
CONTEXT_TURNS=10

# 단일 메시지당 최대 허용 글자 수 (기본값: 4000자, 프론트엔드와 동일하게 적용)
MAX_MESSAGE_CHARS=4000

# ------------------------------------------------------------------------------
# 3. 데이터베이스 설정 (SQLite 또는 Supabase 중 선택)
# ------------------------------------------------------------------------------
# SQLite 사용 시: DB 파일 저장 경로 (기본값: /data/chacha.db, Docker named volume과 연결)
DATABASE_PATH=/data/chacha.db

# Supabase 사용 시 (선택 사항):
# Supabase 프로젝트 URL (예: https://xyzcompany.supabase.co)
SUPABASE_URL=

# Supabase Service Role Key (서버 전용 비밀키, [중요] 절대 커밋 금지)
SUPABASE_SERVICE_ROLE_KEY=

# ------------------------------------------------------------------------------
# 4. 백엔드 서버 네트워크 설정
# ------------------------------------------------------------------------------
# 백엔드 서버가 바인딩할 호스트 및 포트
HOST=0.0.0.0
PORT=8000
